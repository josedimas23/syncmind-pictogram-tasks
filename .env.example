# Copy to .env.local and fill in to run against your own Firebase project.
# Leave the Firebase values empty (or run `npm run demo`) to use the local
# Firestore emulator with demo data instead. Never commit .env.local.

# Firebase web app config (Firebase console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Force the local emulator even when credentials are set
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
# Emulator host (use your computer's LAN IP when testing from a phone)
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# Cloudinary cloud name, used for avatar and step image uploads.
# Requires unsigned upload presets named "avatars_upload" and "step_task_upload".
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
